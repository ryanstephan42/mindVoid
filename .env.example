# Backend
DATABASE_URL=sqlite:////app/data/mindvoid.db
CORS_ORIGINS=http://localhost:3003,http://127.0.0.1:3003

# Authentication
# Leave MINDVOID_PASSWORD unset to disable auth entirely (local development only).
# Set it to any passphrase to require a login before the void is reachable.
MINDVOID_PASSWORD=
# Signs the session tokens. Generate one with: python -c "import secrets; print(secrets.token_urlsafe(32))"
# If unset, a random secret is generated at startup and all sessions end on restart.
MINDVOID_SECRET=
# How long a login lasts, in hours. Defaults to 720 (30 days).
MINDVOID_TOKEN_TTL_HOURS=720

# Frontend
VITE_API_URL=/api
VITE_ALLOWED_HOSTS=localhost,127.0.0.1
VITE_PROXY_TARGET=http://backend:8000
